+package net.plainnotes.app.data
+
+import kotlinx.coroutines.currentCoroutineContext
+import kotlin.coroutines.AbstractCoroutineContextElement
+import kotlin.coroutines.CoroutineContext
+
+/** A conflicting operation is rejected before work starts, never queued or reported as saved. */
+class WriteInProgressException:IllegalStateException("Another write requires confirmation")
+
+/** Process-local exclusion, NOT a database validity cache. Every accepted write still uses its
+ * original transaction, ticket and full audit. Shared by pinned repositories through DatabaseAccess.
+ * A reservation covers all health spaces conservatively; ordinary private notes use another store. */
+internal class WriteAdmission {
+    private val monitor=Any()
+    private var writers=0
+    private var reserved:Reservation?=null
+    val pending:Boolean get()=synchronized(monitor){reserved!=null}
+
+    internal class Permit(val reservation:Reservation):AbstractCoroutineContextElement(Key) {
+        companion object Key:CoroutineContext.Key<Permit>
+    }
+    internal class Reservation internal constructor(private val gate:WriteAdmission) {
+        val context:CoroutineContext=Permit(this)
+        fun release()=gate.release(this)
+    }
+    fun reserve():Reservation=synchronized(monitor) {
+        if(reserved!=null || writers!=0)throw WriteInProgressException()
+        Reservation(this).also{reserved=it}
+    }
+    private fun release(lease:Reservation)=synchronized(monitor) {
+        if(reserved===lease)reserved=null
+    }
+    private fun enter(permit:Permit?):Boolean=synchronized(monitor) {
+        if(permit!=null) {
+            if(reserved!==permit.reservation)throw WriteInProgressException()
+            false
+        } else {
+            if(reserved!=null)throw WriteInProgressException()
+            writers++;true
+        }
+    }
+    suspend fun <T> write(block:suspend()->T):T {
+        val counted=enter(currentCoroutineContext()[Permit])
+        try{return block()}finally{if(counted)synchronized(monitor){writers--}}
+    }
+}
