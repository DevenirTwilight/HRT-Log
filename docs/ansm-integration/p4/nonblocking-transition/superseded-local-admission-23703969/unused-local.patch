+package net.plainnotes.app.data
+
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class WriteAdmissionTest {
+    private fun busy(block:()->Unit){try{block();fail("Conflicting write admitted")}catch(_:WriteInProgressException){}}
+    @Test fun ordinaryWriteCannotBeOvertakenAndReleasesAfterFailure()=runBlocking {
+        val gate=WriteAdmission();val entered=CompletableDeferred<Unit>();val finish=CompletableDeferred<Unit>()
+        val writer=launch{try{gate.write{entered.complete(Unit);finish.await();throw IllegalStateException("SYNTHETIC rollback")}}catch(_:IllegalStateException){}}
+        entered.await();busy{gate.reserve()};finish.complete(Unit);writer.join()
+        gate.reserve().release();assertFalse(gate.pending)
+    }
+    @Test fun reservationRejectsOtherWritersButDoesNotGrantDatabaseTrust()=runBlocking {
+        val gate=WriteAdmission();val lease=gate.reserve();var called=false
+        try{gate.write{called=true};fail("Reservation bypassed")}catch(_:WriteInProgressException){}
+        assertFalse(called);busy{gate.reserve()}
+        withContext(lease.context){gate.write{called=true}}
+        assertTrue(called);assertTrue(gate.pending)
+        lease.release();assertFalse(gate.pending);gate.write{}
+    }
+    @Test fun staleAndForeignPermitsCannotWriteOrReleaseNewReservations()=runBlocking {
+        val gate=WriteAdmission();val old=gate.reserve();old.release();val current=gate.reserve()
+        old.release();assertTrue(gate.pending)
+        for(permit in listOf(old.context,WriteAdmission().reserve().context)) {
+            try{withContext(permit){gate.write{fail("Stale owner wrote")}};fail("Permit accepted")}catch(_:WriteInProgressException){}
+        }
+        current.release();gate.write{}
+    }
+    @Test fun ownerCancellationDoesNotSilentlyUnlockAnUncertainOperation()=runBlocking {
+        val gate=WriteAdmission();val lease=gate.reserve();val entered=CompletableDeferred<Unit>()
+        val owner=launch(lease.context){gate.write{entered.complete(Unit);awaitCancellation()}}
+        entered.await();owner.cancelAndJoin()
+        assertTrue(gate.pending);busy{gate.reserve()}
+        lease.release();assertFalse(gate.pending)
+    }
+}
